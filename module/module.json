{
  "spec_version": "3.0",
  "id": "slsteam",
  "name": "SLSsteam",
  "version": "1.0.0-beta.1",
  "description": "Upstream-first Steam launch extension for added-game support.",
  "repository": "https://github.com/FATEx0/slssteam-ronin",
  "features": [
    "added-games",
    "manifest-pinning",
    "achievement-schemas",
    "compatibility-tools",
    "steamstub-ticket"
  ],
  "capabilities": [
    {
      "id": "steam.launch.audit-library",
      "reason": "Install the ordered SLSsteam Steam-client hooks at launch"
    },
    {
      "id": "filesystem.config",
      "reason": "Let slssteam-control solely own the legacy SLSsteam YAML"
    },
    {
      "id": "filesystem.data",
      "reason": "Persist validated browser-assisted manifest history"
    },
    {
      "id": "filesystem.steam-read",
      "reason": "Compatibility access for Lua-added games and Steam product data"
    },
    {
      "id": "filesystem.steam-write",
      "reason": "Compatibility access for app-info, depot keys and manifests"
    },
    {
      "id": "filesystem.grant.request",
      "reason": "Migrate Steam target writes to operation-scoped grants"
    },
    {
      "id": "network.outbound",
      "reason": "Compatibility access to Steam product and manifest services"
    },
    {
      "id": "secrets.manage",
      "reason": "Classify imported depot keys and tickets as sensitive inputs"
    },
    {
      "id": "mutation.high-impact",
      "reason": "Stage and audit manifest publication into Steam targets"
    },
    {
      "id": "notifications.desktop",
      "reason": "Show optional readiness and compatibility notifications"
    },
    {
      "id": "process.spawn.packaged",
      "reason": "Run the package-owned preparation and control companions"
    },
    {
      "id": "steam.ui.hosted-view",
      "reason": "Show the package-owned Manifest Pins manager"
    }
  ],
  "compatibility_profiles": [
    {
      "id": "ronin-2-broad-steam-filesystem",
      "reason": "Injected legacy code still discovers sensitive depot/ticket inputs and mutates Steam-owned manifest targets directly",
      "removal_milestone": "slssteam-grant-handles"
    },
    {
      "id": "ronin-2-ambient-network",
      "reason": "Injected legacy manifest transport still resolves dynamic Steam CDN origins internally",
      "removal_milestone": "slssteam-network-grants"
    }
  ],
  "dependencies": [],
  "runtime": {
    "components": [
      {
        "id": "slssteam-control",
        "kind": "subprocess",
        "activation": "installed",
        "entry": "payload/slssteam-control",
        "args": [],
        "control": "slssteam-control",
        "restart": {
          "policy": "on-failure",
          "max_attempts": 3
        },
        "shutdown": {
          "grace_ms": 2000
        }
      },
      {
        "id": "steam-hooks",
        "kind": "steam-launch-extension",
        "activation": "enabled",
        "apply": "steam-restart",
        "artifacts": [
          {
            "path": "payload/library-inject.so",
            "role": "audit-library",
            "order": 0
          },
          {
            "path": "payload/SLSsteam.so",
            "role": "audit-library",
            "order": 1
          }
        ],
        "health": {
          "kind": "mapped-library",
          "process": "steam",
          "artifact": "payload/SLSsteam.so",
          "grace_ms": 20000
        },
        "prepare": {
          "entry": "payload/sls-prelaunch",
          "args": [],
          "timeout_ms": 120000
        }
      }
    ],
    "activation_order": ["slssteam-control", "steam-hooks"],
    "shutdown_order": ["steam-hooks", "slssteam-control"]
  },
  "documents": {
    "settings": "settings.json",
    "interface": "interface.json",
    "views": "views.json",
    "resources": "resources.json",
    "content": "content.json"
  }
}
