{
  "manifest_version": 3,
  "name": "Ronin SteamDB History Collector",
  "version": "0.5.1",
  "description": "Exports visible SteamDB build transitions for validated import by SLSsteam Ronin.",
  "permissions": ["activeTab", "downloads", "tabs"],
  "host_permissions": [
    "https://steamdb.info/app/*/patchnotes/*",
    "https://steamdb.info/app/*/dlc/*",
    "https://steamdb.info/app/*/depots/*",
    "https://steamdb.info/patchnotes/*",
    "https://steamdb.info/depot/*/manifests/*"
  ],
  "action": {
    "default_title": "Export Ronin manifest history",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamdb.info/app/*/patchnotes/*",
        "https://steamdb.info/app/*/dlc/*",
        "https://steamdb.info/app/*/depots/*",
        "https://steamdb.info/patchnotes/*",
        "https://steamdb.info/depot/*/manifests/*"
      ],
      "js": ["content.js"]
    }
  ]
}
