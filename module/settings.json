{
  "schema_version": "1.0",
  "storage": {
    "adapter": "line-scalars",
    "path": "$USER_CONFIG/SLSsteam/config.yaml",
    "preserve_unknown": true,
    "atomic": true,
    "min_recognized": 3
  },
  "groups": [
    { "id": "general", "label": "General", "order": 0 },
    { "id": "fake-info", "label": "Fake Info", "order": 10 },
    { "id": "advanced", "label": "Advanced", "order": 20 }
  ],
  "fields": [
    {
      "key": "PlayNotOwnedGames", "type": "bool", "default": false,
      "tier": "basic", "label": "Play not-owned games",
      "description": "Lets Steam launch games that are not in your account.",
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "General", "order": 0 }
    },
    {
      "key": "DisableFamilyShareLock", "type": "bool", "default": true,
      "tier": "basic", "label": "Disable Family Sharing lock",
      "description": "Stops Family Sharing from locking shared games.",
      "apply": { "mode": "steam-restart", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "General", "order": 10 }
    },
    {
      "key": "DisableParentalRestrictions", "type": "bool", "default": false,
      "tier": "basic", "label": "Disable parental restrictions",
      "description": "Locally disables supported Steam Families restrictions.",
      "apply": { "mode": "steam-restart", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "General", "order": 20 }
    },
    {
      "key": "AutoFilterList", "type": "bool", "default": true,
      "tier": "advanced", "label": "Auto-filter app list",
      "description": "Automatically limits ownership checks to games and applications.",
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "General", "order": 30 }
    },
    {
      "key": "Notifications", "type": "bool", "default": true,
      "tier": "basic", "label": "Notifications",
      "description": "Show desktop notifications from Ronin.",
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "General", "order": 40 }
    },
    {
      "key": "NotifyInit", "type": "bool", "default": true,
      "tier": "basic", "label": "Notify when ready",
      "description": "Show a notification after Ronin finishes loading.",
      "apply": { "mode": "steam-restart", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "General", "order": 50 }
    },
    {
      "key": "DisableCloud", "type": "bool", "default": true,
      "tier": "basic", "label": "Disable Steam Cloud",
      "description": "Disable ordinary Steam Cloud for managed added games.",
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "General", "order": 60 }
    },
    {
      "key": "Achievements", "type": "bool", "default": true,
      "tier": "basic", "label": "Achievements for added games",
      "description": "Fetch achievement schemas for games added through Ronin.",
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "General", "order": 70 }
    },
    {
      "key": "FakeEmail", "type": "string", "default": "",
      "tier": "basic", "label": "Fake e-mail",
      "description": "Shows a cosmetic e-mail address in the Steam client.",
      "apply": { "mode": "steam-restart", "target": "steam-hooks" },
      "ui": { "widget": "text", "group": "Fake Info", "order": 0 }
    },
    {
      "key": "FakeWalletBalance", "type": "int", "default": 0,
      "min": 0, "max": 2147483647, "tier": "basic",
      "label": "Fake wallet balance",
      "description": "Shows a cosmetic wallet balance in the Steam client.",
      "apply": { "mode": "steam-restart", "target": "steam-hooks" },
      "ui": { "widget": "number", "group": "Fake Info", "order": 10 }
    },
    {
      "key": "UseWhitelist", "type": "bool", "default": false,
      "tier": "advanced", "label": "Use a whitelist",
      "description": "Treat AppIds as a whitelist rather than a blacklist.",
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "Advanced", "order": 0 }
    },
    {
      "key": "WarnHashMissmatch", "type": "bool", "default": false,
      "tier": "advanced", "label": "Warn on client change",
      "description": "Warn when Steam differs from the known client build.",
      "apply": { "mode": "steam-restart", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "Advanced", "order": 10 }
    },
    {
      "key": "API", "type": "bool", "default": true,
      "tier": "advanced", "label": "Control socket",
      "description": "Enable Ronin's local compatibility control socket.",
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "Advanced", "order": 20 }
    },
    {
      "key": "ExtendedLogging", "type": "bool", "default": false,
      "tier": "advanced", "label": "Verbose logging",
      "description": "Log detailed Steam calls for diagnostics.",
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "toggle", "group": "Advanced", "order": 30 }
    },
    {
      "key": "LogLevel", "type": "enum", "default": 2,
      "tier": "advanced", "label": "Log level",
      "description": "Select Ronin's log verbosity.",
      "enum": [
        { "value": 0, "label": "Once" },
        { "value": 1, "label": "Debug" },
        { "value": 2, "label": "Info" },
        { "value": 3, "label": "NotifyShort" },
        { "value": 4, "label": "NotifyLong" },
        { "value": 5, "label": "Warn" },
        { "value": 6, "label": "None" }
      ],
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "select", "group": "Advanced", "order": 40 }
    },
    {
      "key": "AchievementOwnerId", "type": "uint64",
      "default": "76561198028121353", "tier": "advanced",
      "label": "Default achievement owner",
      "description": "SteamID64 used when no game-specific owner is configured.",
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "text", "group": "Advanced", "order": 50 }
    },
    {
      "key": "AchievementOwners", "type": "uint64-map", "default": {},
      "tier": "advanced", "label": "Per-game achievement owners",
      "description": "Optional AppID to owner SteamID64 overrides.",
      "apply": { "mode": "live", "target": "steam-hooks" },
      "ui": { "widget": "map", "group": "Advanced", "order": 60 }
    }
  ]
}
