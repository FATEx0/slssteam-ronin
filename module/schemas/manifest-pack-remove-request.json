    "plan_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"user_gesture":{"const":true},
    "authority":{"type":"object","additionalProperties":false,"required":["operation_id","confirmation_handle","plan_digest","grant_id","resource_handle"],"properties":{"operation_id":{"type":"string","minLength":1,"maxLength":256},"confirmation_handle":{"type":"string","minLength":1,"maxLength":256},"plan_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"grant_id":{"type":"string","minLength":1,"maxLength":256},"resource_handle":{"type":"string","minLength":1,"maxLength":256}}}
  }
