{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ronin://module/slsteam/manifest-pack.inspect/1/response",
  "type":"object","additionalProperties":false,"required":["plan","plan_digest","summary","effects"],
  "properties":{
    "plan":{"type":"object","additionalProperties":false,"required":["action","app_id","depots"],"properties":{"action":{"enum":["install","remove"]},"app_id":{"type":"string","pattern":"^[1-9][0-9]{0,9}$"},"build_id":{"type":"string","pattern":"^[1-9][0-9]{0,9}$"},"depots":{"type":"object","propertyNames":{"pattern":"^[1-9][0-9]{0,9}$"},"additionalProperties":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"}}}},
    "plan_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "summary":{"type":"string","minLength":1,"maxLength":4096},
    "effects":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"string","minLength":1,"maxLength":1024}}
  }
}
