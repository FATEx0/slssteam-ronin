{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ronin://module/slsteam/pins.list/1/response",
  "type": "object",
  "additionalProperties": false,
  "required": ["apps", "games"],
  "properties": {
    "apps": {"type":"array","maxItems":100000,"items":{"$ref":"#/$defs/pin"}},
    "games": {"type":"array","maxItems":100000,"items":{"$ref":"#/$defs/game"}}
  },
  "$defs": {
    "decimal32": {"type":"string","pattern":"^[0-9]{1,10}$"},
    "decimal64": {"type":"string","pattern":"^[0-9]{1,20}$"},
    "depots": {
      "type":"object",
      "maxProperties":100000,
      "propertyNames":{"pattern":"^[1-9][0-9]{0,9}$"},
      "additionalProperties":{"$ref":"#/$defs/decimal64"}
    },
    "pin": {
      "type":"object","additionalProperties":false,
      "required":["appid","locked","build_id","depots"],
      "properties":{
        "appid":{"$ref":"#/$defs/decimal32"},
        "locked":{"type":"boolean"},
        "build_id":{"$ref":"#/$defs/decimal32"},
        "depots":{"$ref":"#/$defs/depots"}
      }
    },
    "game": {
      "type":"object","additionalProperties":false,
      "required":["appid","title","installed_build_id","manifests"],
      "properties":{
        "appid":{"$ref":"#/$defs/decimal32"},
        "title":{"type":"string","maxLength":4096},
        "installed_build_id":{"$ref":"#/$defs/decimal32"},
        "manifests":{"$ref":"#/$defs/depots"}
      }
    }
  }
}
