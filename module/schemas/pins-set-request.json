{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ronin://module/slsteam/pins.set/1/request",
  "type": "object",
  "additionalProperties": false,
  "required": ["appid", "build_id", "depots"],
  "properties": {
    "appid": {"type":"string","pattern":"^[1-9][0-9]{0,9}$"},
    "build_id": {"type":"string","pattern":"^[1-9][0-9]{0,9}$"},
    "locked": {"type":"boolean"},
    "depots": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100000,
      "propertyNames": {"pattern":"^[1-9][0-9]{0,9}$"},
      "additionalProperties": {
        "type":"string",
        "pattern":"^[1-9][0-9]{0,19}$"
      }
    }
  }
}
